{
  "name": "jarvis-desktop",
  "private": true,
  "version": "0.4.1",
  "license": "AGPL-3.0-only",
  "type": "module",
  "scripts": {
    "dev": "vite --config apps/desktop/vite.config.ts",
    "build": "tsc --noEmit && vite build --config apps/desktop/vite.config.ts",
    "build:mobile": "tsc --noEmit && node apps/mobile/build.mjs",
    "tauri": "tauri",
    "release": "tauri build",
    "test": "vitest run --exclude **/parse.ai.test.ts",
    "icons": "node scripts/build-icons.mjs",
    "test:workspace": "cargo test -p jarvis-workspace",
    "test:integration": "node scripts/test-workspace.mjs"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.13.1",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@lezer/highlight": "^1.2.5",
    "@tauri-apps/api": "2.12.4",
    "clsx": "^2.1.1",
    "lucide-react": "^1.72.0",
    "qrcode-generator": "^1.4.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5",
    "sonner": "^2.0.8"
  },
  "devDependencies": {
    "@lezer/markdown": "^1.8.1",
    "@noble/ciphers": "^2.4.0",
    "@resvg/resvg-js": "^2.6.2",
    "@tailwindcss/vite": "^4.3.5",
    "@tauri-apps/cli": "2.12.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "hash-wasm": "^4.12.0",
    "lucide": "^0.460.0",
    "tailwindcss": "^4.3.5",
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "vitest": "^5.1.0"
  }
}
